# ==========================================
# Intel Quartus Prime Standard .gitignore
# ==========================================

# --- 仿真文件 ---
/SIM

# --- Quartus 编译数据库与中间目录 (体积极大，严格禁止提交) ---
/db/
/incremental_db/
/greybox_tmp/
/hc_output/
/hps_isw_handoff/

# --- Quartus 个人界面与工作区配置 ---
*.qws

# --- 编译生成的 FPGA 下载镜像/配置文件 (可根据团队需求决定是否追踪) ---
*.sof
*.pof
*.jam
*.jbc
*.ekp
*.rbf
*.hex.out

# --- 编译过程产生的日志、报告与统计文件 ---
*.jdi
*.rpt
*.summary
*.smsg
*.pin
*.done
*.qdf
*.qws
*.chg
*.htm
*.html

# --- ModelSim / QuestaSim / EDA 仿真临时目录与输出 ---
/simulation/
/work/
*.wlf
*.mpf
transcript

# --- Platform Designer (Qsys) 自动生成产物 ---
# 说明：仅保留 .qsys 源文件，忽略编译生成的 Verilog/VHDL 代码和仿真库
/*_generation/
/*_sim/
*.qsys.bak
*.sopc_builder/

# --- IDE 及编辑器个人配置 (VS Code) ---
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
*.bak

# --- 操作系统临时文件 ---
.DS_Store
Thumbs.db
desktop.ini